    {
      "id": "add-foreign-key",
      "title": "Add a foreign key with foreign_key_checks on (the default)",
      "session": [
        "SET foreign_key_checks = 1"
      ],
      "statement": "ALTER TABLE orders ADD CONSTRAINT fk_orders_user FOREIGN KEY (user_id) REFERENCES users (id)",
      "verdict": {
        "result": "runs",
        "algorithm": "COPY",
        "rebuilds_table": true,
        "copied_rows": 1000,
        "writes": "blocked",
        "consistent": true
      },
      "observations": [
        {
          "variant": {
            "algorithm": null,
            "lock_none": false
          },
          "result": "accepted",
          "copied_rows": 1000,
          "rebuilt": true,
          "row_versions": [
            0,
            0
          ]
        },
        {
          "variant": {
            "algorithm": "INSTANT",
            "lock_none": false
          },
          "result": "rejected",
          "code": 1846,
          "message": "ALGORITHM=INSTANT is not supported. Reason: Adding foreign keys needs foreign_key_checks=OFF. Try ALGORITHM=COPY/INPLACE."
        },
        {
          "variant": {
            "algorithm": "INPLACE",
            "lock_none": false
          },
          "result": "rejected",
          "code": 1846,
          "message": "ALGORITHM=INPLACE is not supported. Reason: Adding foreign keys needs foreign_key_checks=OFF. Try ALGORITHM=COPY."
